# ─────────────────────────────────────────────────────────────────────────────
# LeadRadar — Variables de entorno para ejecución LOCAL
# Copia este archivo como .env y completa los valores:
#   cp env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Modo de autenticación ─────────────────────────────────────────────────────
# Pon LOCAL_AUTH=true para usar usuario/contraseña local (sin Manus OAuth)
LOCAL_AUTH=true

# ── Credenciales de administrador local ──────────────────────────────────────
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=leadradar2024

# (Opcional) Contraseña hasheada con bcrypt — si se define, tiene prioridad sobre LOCAL_ADMIN_PASSWORD
# Para generar el hash: node -e "const b=require('bcryptjs');b.hash('tu_password',12).then(console.log)"
# LOCAL_ADMIN_PASSWORD_HASH=$2b$12$...

# ── Base de datos MySQL ───────────────────────────────────────────────────────
# Formato: mysql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=mysql://leadradar:leadradar_pass@localhost:3306/leadradar

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Clave secreta para firmar las cookies de sesión — usa una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria-min-32-chars

# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=3000

# ── Variables de Manus (NO necesarias en modo local) ─────────────────────────
# Dejar vacías o comentar en modo LOCAL_AUTH=true
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
